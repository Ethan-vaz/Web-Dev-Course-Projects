<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" />
</head>

<body>
    <!-- navigation -->
    <div class="navbar shadow-sm bg-neutral text-neutral-content">
        <div class="flex-1">
            <a class="btn btn-ghost text-xl">College Parking</a>
        </div>
        <div class="flex-none">
            <ul class="menu menu-horizontal px-1">
                <li><a href="/">Admin</a></li>
                <li><a href="/forms/parking">Pay for Parking</a></li>                
            </ul>
        </div>
    </div>

    <div class="container mx-auto my-4">

        <h1 class="text-3xl my-8">Parked Cars</h1>

        <ul class="list bg-base-200 rounded-box shadow-md w-1/3">


            <!-- --------- start of example UI for a list --- -->
            <!-- ---------------------------------------------- -->
            
            <!-- example ui for the first 2 rows of the list -->
                <% for( let i = 0; i < cars.length; i++ ) { %>
                <li class="list-row">
                <div class="text-4xl font-thin opacity-30 tabular-nums">
                    <%= cars[i].licensePlate %>
                </div>

                <div>
                    <div><%= cars[i].model %></div>
                    <div class="text-xs uppercase font-semibold opacity-60">Hours: <%= cars[i].hours %></div>
                </div>
                <div>
                    <p>$<%= cars[i].cost %></p>
                </div>
                </li>
                <% } %>


            <!-- example ui for the last row of the list -->
            <li class="list-row">
                <div class="text-4xl font-thin">
                    Total
                </div>

                <div>
                </div>

                <div>
                    <p class="text-4xl font-thin "> $ <%= Total %> </p>
                </div>
            </li>

            <!-- ---------------------------------------------- -->
            <!-- end of example ui for a DaisyUI List Component -->
            
        </ul>

    </div>
</body>

</html>